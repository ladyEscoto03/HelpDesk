
@model HelpDesk.Models.ReportViewModel
@{
    ViewBag.Title = "Index";
}

<h2 class="mb-4 fw-bold text-primary">Reporte de tickets</h2>
@if (User.IsInRole("Administrador"))
{
    <a href="@Url.Action("Index", "Tickets", new { area = "" })"
       class="btn btn-sm btn-dark"
       title="Ver tiquetes">
        Ver tiquetes
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-ticket-perforated-fill" viewBox="0 0 16 16">
            <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 1 0 0-3A.5.5 0 0 1 0 6zm4-1v1h1v-1zm1 3v-1H4v1zm7 0v-1h-1v1zm-1-2h1v-1h-1zm-6 3H4v1h1zm7 1v-1h-1v1zm-7 1H4v1h1zm7 1v-1h-1v1zm-8 1v1h1v-1zm7 1h1v-1h-1z" />
        </svg>
    </a>
}
<h3 class="h5 fw-bold mb-3 text-dark">Tickets por estado</h3>

<table class="table table-bordered table-striped table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th class="py-3">Estado</th>
            <th class="py-3 text-center">Cantidad de tickets</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td class="fw-semibold">
                <span class="badge bg-primary me-2"> </span>
                Abierto
            </td>
            <td class="text-center fw-semibold">@Model.OpenTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-info me-2"> </span>
                Asignado
            </td>
            <td class="text-center fw-semibold">@Model.AssignedTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-warning me-2"> </span>
                En progreso
            </td>
            <td class="text-center fw-semibold">@Model.InProgressTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-secondary me-2"> </span>
                Pendiente
            </td>
            <td class="text-center fw-semibold">@Model.PendingTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-success me-2"> </span>
                Resuelto
            </td>
            <td class="text-center fw-semibold">@Model.ResolvedTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-dark me-2"> </span>
                Cerrado
            </td>
            <td class="text-center fw-semibold">@Model.ClosedTickets</td>
        </tr>

        <tr>
            <td class="fw-semibold">
                <span class="badge bg-danger me-2"> </span>
                Cancelado
            </td>
            <td class="text-center fw-semibold">@Model.CancelledTickets</td>
        </tr>
    </tbody>

    <tfoot class="table-primary">
        <tr>
            <th class="py-3">Total de tickets</th>
            <th class="py-3 text-center fw-bold">@Model.TotalTickets</th>
        </tr>
    </tfoot>
</table>

<hr class="my-4 text-secondary" />

<h3 class="h5 fw-bold mb-3 text-dark">Tiempo promedio de resolución</h3>

<p class="bg-light border rounded-3 shadow-sm p-4 mb-0">
    <span class="d-block text-secondary small fw-semibold mb-2">
        PROMEDIO DE RESOLUCIÓN
    </span>
    <span class="display-6 fw-bold text-primary">
        @Model.AverageResolutionHours.ToString("0.00")
    </span>
    <span class="text-secondary fw-semibold">horas</span>
</p>
