
@model HelpDesk.Models.ReportViewModel
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<h2>Reporte de tickets</h2>

<h3>Tickets por estado</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Estado</th>
            <th>Cantidad de tickets</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>Abierto</td>
            <td>@Model.OpenTickets</td>
        </tr>

        <tr>
            <td>Asignado</td>
            <td>@Model.AssignedTickets</td>
        </tr>

        <tr>
            <td>En progreso</td>
            <td>@Model.InProgressTickets</td>
        </tr>

        <tr>
            <td>Pendiente</td>
            <td>@Model.PendingTickets</td>
        </tr>

        <tr>
            <td>Resuelto</td>
            <td>@Model.ResolvedTickets</td>
        </tr>

        <tr>
            <td>Cerrado</td>
            <td>@Model.ClosedTickets</td>
        </tr>

        <tr>
            <td>Cancelado</td>
            <td>@Model.CancelledTickets</td>
        </tr>
    </tbody>

    <tfoot>
        <tr>
            <th>Total de tickets</th>
            <th>@Model.TotalTickets</th>
        </tr>
    </tfoot>
</table>

<hr />

<h3>Tiempo promedio de resolución</h3>

<p>
    @Model.AverageResolutionHours.ToString("0.00") horas
</p>