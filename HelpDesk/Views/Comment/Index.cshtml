@model IEnumerable<HelpDesk.Models.Comment>

@{
    ViewBag.Title = "Index";
}
<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-2">Historial de comentarios</h2>
        <p class="text-muted mb-0">
            Consulta los comentarios registrados y sus detalles.
        </p>
    </div>

    <div class="d-flex flex-column gap-2">

        @foreach (var item in Model)
        {
            <div class="card border rounded-3 shadow-sm">

                <div class="card-body p-2">

                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">

                        <div>
                            <h5 class="fw-bold text-dark mb-2">
                                @Html.DisplayFor(modelItem => item.Ticket.Title)
                            </h5>

                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-circle bg-dark text-white p-2">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                <span class="text-dark fw-semibold">
                                    @Html.DisplayFor(modelItem => item.User.Name)
                                </span>
                            </div>
                        </div>

                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>
                            @Html.DisplayFor(modelItem => item.CreatedDate)
                        </div>

                    </div>

                    <hr class="text-secondary opacity-25" />

                    <div>
                        <small class="text-uppercase fw-bold text-secondary">
                            Descripción
                        </small>

                        <p class="text-dark mb-0 mt-2 lh-lg">
                            @Html.DisplayFor(modelItem => item.Description)
                        </p>
                    </div>

                </div>
            </div>
        }

    </div>

</div>
