@model IEnumerable<HelpDesk.Models.Ticket>

@{
    ViewBag.Title = "Index";
}


<button type="button"
        class="btn btn-sm btn-dark"
        data-bs-toggle="modal"
        data-bs-target="#CreateTicket"
        title="Crear tiquete">
    Crear Tiquete
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-ticket-perforated-fill" viewBox="0 0 16 16">
        <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 1 0 0-3A.5.5 0 0 1 0 6zm4-1v1h1v-1zm1 3v-1H4v1zm7 0v-1h-1v1zm-1-2h1v-1h-1zm-6 3H4v1h1zm7 1v-1h-1v1zm-7 1H4v1h1zm7 1v-1h-1v1zm-8 1v1h1v-1zm7 1h1v-1h-1z" />
    </svg>
</button>

@if (User.IsInRole("Administrador"))
{
    <a href="@Url.Action("Index", "Report", new { area = "" })"
       class="btn btn-sm btn-dark"
       title="Ver reportes">
        Reportes
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-data-fill" viewBox="0 0 16 16">
            <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5z" />
            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5zM10 8a1 1 0 1 1 2 0v5a1 1 0 1 1-2 0zm-6 4a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0zm4-3a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1" />
        </svg>
    </a>
}



<div class="modal fade" id="CreateTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-dark text-white py-3 px-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Crear comentario
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-white" id="CreateTicketContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-dark"></div>
                    <p class="mt-3 text-dark fw-semibold">Cargando formulario...</p>
                </div>
            </div>

        </div>
    </div>
</div>




<div class="modal fade" id="CreateComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-dark text-white py-3 px-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Crear comentario
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-white" id="CreateCommentContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-dark"></div>
                    <p class="mt-3 text-dark fw-semibold">Cargando formulario...</p>
                </div>
            </div>

        </div>
    </div>
</div>




<div class="modal fade" id="IndexComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-dark text-white py-3 px-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
