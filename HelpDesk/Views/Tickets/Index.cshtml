@model IEnumerable<HelpDesk.Models.Ticket>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>



<div class="modal fade" id="CreateComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Crear comentario
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="CreateCommentContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando formulario...</p>
                </div>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="IndexComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="IndexCommentContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando comentarios...</p>
                </div>
            </div>

        </div>
    </div>
</div>




<div class="modal fade" id="EditTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="EditTicketContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando...</p>
                </div>
            </div>

        </div>
    </div>
</div>


<form id="formBuscar" class="form-control">

    <label class="control-label">Ingrese dato a buscar</label>

    <input type="text"
           id="buscarTexto"
           class="form-control"
           placeholder="Buscar por ID, título, descripción o solicitante..." />

    <label class="control-label">Seleccione estado</label>

    <select id="buscarEstado" class="form-control">
        <option value="">Todos</option>
        <option value="Abierto">Abierto</option>
        <option value="Asignado">Asignado</option>
        <option value="En progreso">En progreso</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Resuelto">Resuelto</option>
        <option value="Cancelado">Cancelado</option>
        <option value="Cerrado">Cerrado</option>
    </select>

</form>

<hr />

<div id="tablaResultados">
    @Html.Partial("_TablaTickets", Model)
</div>


@section Scripts {

    <script>

        $(document).ready(function () {

    function buscarTickets() {

        var texto = $("#buscarTexto").val();
        var estado = $("#buscarEstado").val();
        var id = null;

        if ($.isNumeric(texto)) {
            id = parseInt(texto);
            texto = "";
        }

        $.ajax({
            url: '@Url.Action("Search", "Tickets")',
            type: 'GET',

            data: {
                id: id,
                texto: texto,
                estado: estado
            },

            success: function (resultado) {

                $("#tablaResultados").html(resultado);

            },

            error: function (xhr, status, error) {

                console.log("Estado:", status);
                console.log("Error:", error);
                console.log("Respuesta del servidor:", xhr.responseText);

                alert("Error: " + xhr.status + " - " + error);

            }
        });
    }

    // Buscar cuando se escribe
    $("#buscarTexto").on("keyup", function () {
        buscarTickets();
    });

    // Buscar cuando cambia el estado
    $("#buscarEstado").on("change", function () {
        buscarTickets();
    });

});


        $('#EditTicket').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('ticket-id');

            $.get('@Url.Action("Edit", "Tickets")',
                { id: id },
                function(data) {
                    $('#EditTicketContent').html(data);
                }
            );

        });





        $('#CreateComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Create", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#CreateCommentContent').html(data);
                }
            );

        });

        $('#IndexComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Index", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#IndexCommentContent').html(data);
                }
            );
        });



    </script>

}