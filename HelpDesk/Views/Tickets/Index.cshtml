            </div>

            <div class="modal-body p-4 bg-white" id="IndexCommentContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-dark"></div>
                    <p class="mt-3 text-dark fw-semibold">Cargando comentarios...</p>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="EditTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

            <div class="modal-header bg-dark text-white py-3 px-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-white" id="EditTicketContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-dark"></div>
                    <p class="mt-3 text-dark fw-semibold">Cargando...</p>
                </div>
            </div>

        </div>
    </div>
</div>


<form id="Search" class="form-control border-secondary rounded-3 shadow-sm p-4 mt-3">

    <label class="control-label form-label fw-semibold text-dark">Ingrese dato a buscar</label>

    <input type="text"
           id="text"
           class="form-control border-secondary rounded-2 mb-3"
           placeholder="Buscar por ID, título, descripción o solicitante..." />

    <label class="control-label form-label fw-semibold text-dark">Seleccione estado</label>

    <select id="status" class="form-control form-select border-secondary rounded-2">
        <option value="">Todos</option>
        <option value="Abierto">Abierto</option>
        <option value="Asignado">Asignado</option>
        <option value="En progreso">En progreso</option>
        <option value="Pendiente">Pendiente</option>
        <option value="Resuelto">Resuelto</option>
        <option value="Cancelado">Cancelado</option>
        <option value="Cerrado">Cerrado</option>
    </select>

</form>



<hr />

<div id="tablaResultados">
    @Html.Partial("_TablaTickets", Model)
</div>


@section Scripts {

    <script>

        $(document).ready(function () {

            function searchTickets() {

                var text = $("#text").val();
                var status = $("#status").val();
                var id = null;


                if ($.isNumeric(text)) {
                    id = parseInt(text);
                    text = "";
                }

                $.ajax({
                    url: '@Url.Action("Search", "Tickets")',
                    type: 'GET',
                    data: {
                        id: id,
                text: text,
                status: status
            },

            success: function (result) {

                $("#tablaResultados").html(result);

            },

            error: function () {

                alert("Ups! Algo salío mal");

            }
        });
    }

            $("#text").on("keyup", function () {
                searchTickets();
            });


            $("#status").on("change", function () {
                searchTickets();
            });

        });


        $('#CreateTicket').on('show.bs.modal', function (event) {

            $.get('@Url.Action("Create", "Tickets")', function (data) {
                $('#CreateTicketContent').html(data);
            });
        })


        $(document).on('submit', '#CreateTicketContent form', function (e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),

                success: function (response) {

                    $('#CreateTicket').modal('hide');
                    $('#CreateTicketContent').html('');
                    refreshTicketsTable();
                },
                error: function () {
                    alert('Error al guardar el tiquete.');
                }
            });

        });


        $('#EditTicket').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('ticket-id');

            $.get('@Url.Action("Edit", "Tickets")',
                { id: id },
                function(data) {
                    $('#EditTicketContent').html(data);

                }
            );

        });

        $(document).on('submit', '#EditTicketContent form', function (e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),

                success: function (response) {

                    $('#EditTicket').modal('hide');
                    $('#EditTicketContent').html('');
                    refreshTicketsTable();
                },
                error: function () {
                    alert('Error al guardar el tiquete.');
                }
            });

        });


        $('#CreateComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Create", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#CreateCommentContent').html(data);
                }
            );

        });

        $(document).on('submit', '#CreateCommentContent form', function (e) {

            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),

                success: function (response) {

                    $('#CreateComment').modal('hide');
                    $('#CreateCommentContent').html('');
                    refreshTicketsTable();
                },
                error: function () {
                    alert('Error al guardar el tiquete.');
                }
            });

        });


        $('#IndexComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Index", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#IndexCommentContent').html(data);
                }
            );
        });


     function refreshTicketsTable() {

    $.ajax({
        url: '@Url.Action("RefreshTickets", "Tickets")',
        type: 'GET',
        success: function (result) {
            $("#tablaResultados").html(result);
        },
        error: function () {
            alert("Ups! Algo salió mal");
        }
    });

}



    </script>

}

