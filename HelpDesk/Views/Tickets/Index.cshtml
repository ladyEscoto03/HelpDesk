@model IEnumerable<HelpDesk.Models.Ticket>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>



<div class="modal fade" id="CreateComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Crear comentario
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="CreateCommentContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando formulario...</p>
                </div>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="IndexComment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="IndexCommentContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando comentarios...</p>
                </div>
            </div>

        </div>
    </div>
</div>




<div class="modal fade" id="EditTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text"></i>
                    Comentarios
                </h5>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4" id="EditTicketContent">
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Cargando...</p>
                </div>
            </div>

        </div>
    </div>
</div>




<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Requester.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Category)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TicketStatus.Name)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Requester.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TicketStatus.Name)
            </td>
            <td>
                <!--
         @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
     @Html.ActionLink("Details", "Details", new { id = item.Id }) |
     @Html.ActionLink("Delete", "Delete", new { id = item.Id })
    -->
                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#CreateComment"
                        data-ticket-id="@item.Id">
                    <i class="bi bi-plus-circle"></i> Nuevo comentario
                </button>

                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#IndexComment"
                        data-ticket-id="@item.Id">
                    <i class="bi bi-plus-circle"></i> Ver comentarios
                </button>

                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#EditTicket"
                        data-ticket-id="@item.Id">
                    <i class="bi bi-plus-circle"></i> Editar
                </button>

                

            </td>
        </tr>
    }

</table>

@section Scripts {

    <script>



        $('#EditTicket').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Edit", "Tickets")',
                { id: ticketId },
                function(data) {
                    $('#EditTicketContent').html(data);
                }
            );

        });





        $('#CreateComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Create", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#CreateCommentContent').html(data);
                }
            );

        });

        $('#IndexComment').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var ticketId = button.data('ticket-id');

            $.get('@Url.Action("Index", "Comment")',
                { ticketId: ticketId },
                function(data) {
                    $('#IndexCommentContent').html(data);
                }
            );
        });



    </script>

}