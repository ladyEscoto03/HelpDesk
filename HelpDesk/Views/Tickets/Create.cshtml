@model HelpDesk.Models.Ticket

@{
    ViewBag.Title = "Create";
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal card shadow-sm border-0 p-4 rounded-3">
        <h4 class="fw-bold text-dark mb-3">
            <i class="glyphicon glyphicon-tag"></i> Ticket
        </h4>
        <hr class="border-dark opacity-50" />

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="form-group mb-4">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2 fw-bold text-dark mb-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control rounded-2 shadow-sm" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mb-4">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2 fw-bold text-dark mb-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control rounded-2 shadow-sm", rows = 10, cols = 60 })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mb-4">
            @Html.LabelFor(model => model.Category, htmlAttributes: new { @class = "control-label col-md-2 fw-bold text-dark mb-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.Category,
                    new SelectList(new[] {
                        "Hardware",
                        "Software",
                        "Redes",
                        "Acceso y permisos",
                        "Correo electrónico",
                        "Impresoras",
                        "Sistemas",
                        "Otros"
                    }),
                    "Seleccione una categoría",
                    new { @class = "form-control rounded-2 shadow-sm" })

                @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-dark px-4 py-2 rounded-2 shadow-sm fw-bold" />
            </div>
        </div>
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
